# Copy to /etc/cpa-manager-plus-separated/worker.env and keep mode 0600.
# The DSN file itself must also be mode 0600 and readable by cpa-manager-plus.
CPAMP_USAGE_PG_DSN_FILE=/etc/cpa-manager-plus/secrets/usage-pg-dsn
CPAMP_USAGE_REDIS_ADDR=127.0.0.1:6379
CPAMP_USAGE_REDIS_DB=0
CPAMP_USAGE_REDIS_STREAM=cpamp:usage:v1
CPAMP_USAGE_REDIS_GROUP=cpamp-persist-v1
CPAMP_USAGE_REDIS_CONSUMER=cpamp-persist-v1
# CPAMP_USAGE_REDIS_PASSWORD_FILE=/etc/cpa-manager-plus/secrets/redis-password
