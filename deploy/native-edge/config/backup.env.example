# Copy to /etc/cpa-manager-plus-separated/backup.env. Database names accept
# only PostgreSQL identifiers separated by spaces.
CPAMP_BACKUP_DIR=/var/backups/cpa-manager-plus/postgresql
CPAMP_BACKUP_DATABASES="cpamp_usage sub2api"
CPAMP_BACKUP_RETENTION_DAYS=14
CPAMP_BACKUP_PG_HOST=/var/run/postgresql
CPAMP_BACKUP_PG_PORT=5432
CPAMP_BACKUP_PG_USER=postgres
