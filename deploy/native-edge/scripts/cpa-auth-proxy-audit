#!/usr/bin/env python3
"""Audit CPA auth JSON proxy overrides without printing credentials."""

from __future__ import annotations

import argparse
import json
import os
import stat
import tempfile
from pathlib import Path
from urllib.parse import urlsplit


VALID_PROXY_SCHEMES = {"http", "https", "socks4", "socks4a", "socks5", "socks5h"}
PROXY_FIELDS = ("proxy_url", "proxy-url")


def valid_proxy(value: object) -> bool:
    if value == "":
        return True
    if not isinstance(value, str):
        return False
    parsed = urlsplit(value)
    return parsed.scheme.lower() in VALID_PROXY_SCHEMES and bool(parsed.hostname)


def replace_json(path: Path, payload: dict[str, object], file_stat: os.stat_result) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".proxy-audit.", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as target:
            json.dump(payload, target, ensure_ascii=False, separators=(",", ":"))
            target.write("\n")
            target.flush()
            os.fsync(target.fileno())
        os.chown(temporary_path, file_stat.st_uid, file_stat.st_gid)
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except BaseException:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Audit CPA auth proxy overrides and private file permissions"
    )
    parser.add_argument("--auth-dir", default="/var/lib/cliproxyapi/auth")
    parser.add_argument(
        "--fix",
        action="store_true",
        help="remove malformed proxy overrides and set JSON files to mode 0600",
    )
    args = parser.parse_args()

    auth_dir = Path(args.auth_dir)
    if not auth_dir.is_dir():
        print(f"auth_dir_missing={auth_dir}")
        return 2

    errors = 0
    repaired = 0
    files = sorted(auth_dir.glob("*.json"))
    for path in files:
        if path.is_symlink():
            print(f"auth_file={path.name} status=unsafe_symlink")
            errors += 1
            continue

        file_stat = path.stat()
        try:
            with path.open("r", encoding="utf-8") as source:
                payload = json.load(source)
        except (OSError, json.JSONDecodeError):
            print(f"auth_file={path.name} status=invalid_json")
            errors += 1
            continue

        if not isinstance(payload, dict):
            print(f"auth_file={path.name} status=invalid_root_type")
            errors += 1
            continue

        invalid_fields = [
            field for field in PROXY_FIELDS if field in payload and not valid_proxy(payload[field])
        ]
        permissions_private = stat.S_IMODE(file_stat.st_mode) == 0o600

        if args.fix:
            for field in invalid_fields:
                payload.pop(field, None)
            if invalid_fields:
                replace_json(path, payload, file_stat)
            elif stat.S_IMODE(file_stat.st_mode) != 0o600:
                os.chmod(path, 0o600)
            if invalid_fields or stat.S_IMODE(file_stat.st_mode) != 0o600:
                repaired += 1
                print(f"auth_file={path.name} status=repaired")
            continue

        if invalid_fields:
            print(
                f"auth_file={path.name} status=invalid_proxy_override "
                f"field_count={len(invalid_fields)}"
            )
            errors += 1
        if not permissions_private:
            print(f"auth_file={path.name} status=permissions_too_open")
            errors += 1

    print(
        f"auth_files={len(files)} errors={errors} repaired={repaired} "
        f"mode={'fix' if args.fix else 'audit'}"
    )
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
