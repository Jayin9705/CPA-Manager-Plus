# Copy to a private env file before starting the optional parallel stack.
# Point these at the existing private Redis/PostgreSQL/CPA services; no data
# volume is created by the separated compose file.
HTTP_ADDR=0.0.0.0:18317
# The API-only build tag is selected by Dockerfile.manager-server-api; it is
# not a runtime switch.
# Set this only for a parallel validation process while the existing Manager
# owns the live CPA/Redis usage pipeline. Leave false for the production API
# after the single-process cutover.
CPAMP_API_SHADOW_MODE=true

# When reusing an existing PostgreSQL data plane, the API must use the same
# data key that encrypts the Manager configuration. Do not let a new instance
# generate a different key. Mount the key privately or set
# CPA_MANAGER_DATA_KEY_FILE/CPA_MANAGER_DATA_KEY in this env file.
# CPA_MANAGER_DATA_KEY_FILE=/run/secrets/cpa_data_key
# CPA_MANAGER_ADMIN_KEY_FILE=/run/secrets/cpa_admin_key

CPAMP_PERSISTENCE_BACKEND=postgres
CPAMP_CORE_PG_DSN=postgres://cpamp:change-me@host.docker.internal:5432/cpamp_core
CPAMP_USAGE_PG_DSN=postgres://cpamp:change-me@host.docker.internal:5432/cpamp_usage
CPAMP_AUTH_PG_DSN=postgres://cpamp:change-me@host.docker.internal:5432/cpamp_auth
CPAMP_USAGE_REDIS_ADDR=host.docker.internal:6379
CPAMP_AUTH_REDIS_ADDR=host.docker.internal:6379
CPAMP_USAGE_SINK=redis
CPAMP_USAGE_SQLITE_HOURLY_ROLLUP_ENABLED=false
CPAMP_USAGE_SQLITE_ACCOUNT_ROLLUP_ENABLED=false
CPAMP_CONSOLE_ORIGINS=http://localhost:18080
CPAMP_CSRF_ENABLED=true
CPAMP_PUBLIC_API_ORIGIN=http://localhost:18318
CPAMP_PUBLIC_CONSOLE_ORIGIN=http://localhost:18080
CPA_UPSTREAM_URL=http://host.docker.internal:8317
CPA_MANAGEMENT_KEY_FILE=/run/secrets/cpa_management_key
