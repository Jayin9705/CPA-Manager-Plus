# Public, non-secret deployment settings. bootstrap-stack.sh copies this file
# to runtime/.env; all actual credentials are generated under runtime/secrets/.
COMPOSE_PROJECT_NAME=cpamp
TZ=Asia/Shanghai

POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:7.4-alpine
CPA_IMAGE=eceasy/cli-proxy-api:latest
CPAMP_API_IMAGE=cpa-manager-plus-api:local
CPAMP_CONSOLE_IMAGE=cpa-manager-plus-console:local

CPA_BIND_ADDRESS=127.0.0.1
CPA_PORT=8317
CPAMP_API_BIND_ADDRESS=127.0.0.1
CPAMP_API_PORT=18318
CPAMP_CONSOLE_BIND_ADDRESS=127.0.0.1
CPAMP_CONSOLE_PORT=18080

# Change these three origins together when serving through a domain or HTTPS.
CPAMP_CONSOLE_ORIGIN=http://localhost:18080
CPAMP_PUBLIC_API_ORIGIN=http://localhost:18318
CPAMP_COOKIE_SECURE=false

# This value is not a password. The password is generated into a local secret.
CPAMP_ADMIN_EMAIL=admin@localhost
