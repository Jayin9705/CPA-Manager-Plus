FROM node:22-alpine AS build
ARG VERSION=dev
WORKDIR /app
COPY package*.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --ignore-scripts
COPY apps/web ./apps/web
# The standalone Nginx image serves the console at /. Native deployments can
# keep the build script's /separated-console/ default or set their own base.
RUN VITE_BASE_PATH=/ VERSION=$VERSION npm --workspace apps/web run build:separated

FROM nginx:1.27-alpine
COPY deploy/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist-separated /usr/share/nginx/html
RUN cp /usr/share/nginx/html/runtime-config.json.example /usr/share/nginx/html/runtime-config.json
EXPOSE 8080
